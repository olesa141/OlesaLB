<Window x:Class="ШероноваОЛеся.Main_empty"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ШероноваОЛеся"
        mc:Ignorable="d"
        Title="Main_empty" Height="600" Width="800">
    <Grid>
        
        <Label Content="Добро пожаловать!" HorizontalAlignment="Left" Margin="252,146,0,0" VerticalAlignment="Top" FontSize="36"/>
        <Label Content="Создайте свою первую &#xD;&#xA;задачу!" HorizontalAlignment="Left" Margin="252,28,0,0" VerticalAlignment="Top" FontSize="36" Grid.Row="1"/>
        <Button Content="Создать первую задачу" HorizontalAlignment="Left" Margin="278,261,0,0" Background="#de4949" VerticalAlignment="Top" FontSize="22" Height="38" Width="284" Grid.Row="1" Click="CreateTaskButton_Click">
        <Button.Resources>
            <Style TargetType="{x:Type Border}">
                <Setter Property="CornerRadius" Value="5 5 5 5 "/>
            </Style>
        </Button.Resources>
        </Button>
        <Image HorizontalAlignment="Left" Height="166" Margin="25,24,0,0" VerticalAlignment="Top" Width="195" RenderTransformOrigin="0.398,0.444" Source="C:\Users\User\Desktop\ШероноваОЛеся\images\фото.jpg" Grid.RowSpan="2" MouseLeftButtonDown="CreateTaskButton_Clicke"  Stretch="Fill"/>

        <Popup x:Name="popup" Placement="Left" AllowsTransparency="True">
            <Border Background="White" BorderBrush="LightGray" BorderThickness="1" Padding="20">
                <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                    <Button Content="Выход" Click="ChangeProfileImage_Click"/>
                    <Button Content="Изменить фото профиля" Click="Logout_Click"/>
                </StackPanel>
            </Border>
        </Popup>
        
    </Grid>
</Window>
