<Window x:Class="ШероноваОЛеся.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ШероноваОЛеся"
        mc:Ignorable="d"
        Title="Main" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с навигацией -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок Main -->

                <!-- Навигация Задачи/История -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Профиль пользователя -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" 
                           VerticalAlignment="Center" Margin="0,0,20,0">
                    <Ellipse Width="32" Height="32" Fill="#007ACC"/>
                    <TextBlock Text="Alex" Margin="10,0,0,0"
                              VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="Задачи" FontWeight="Bold" 
                              Foreground="#007ACC"
                              FontSize="14" Grid.ColumnSpan="2" Margin="44,21,622,21"/>
                <TextBlock Text="История" Foreground="#666" 
                              FontSize="14" Grid.Column="1" Margin="118,22,488,19"/>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть - категории и список задач -->
            <Grid Grid.Column="0" Background="#F5F5F5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Категории -->
                <Border Grid.Row="0" Background="White" Height="50">
                    <StackPanel Orientation="Horizontal" Margin="20,0">
                        <TextBlock Text="Дом" Margin="0,0,20,0" FontWeight="Bold" 
                                  Foreground="#007ACC" VerticalAlignment="Center"/>
                        <TextBlock Text="Работа" Margin="0,0,20,0" Foreground="#666"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Учеба" Margin="0,0,20,0" Foreground="#666"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="Отдых" Foreground="#666"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Список задач -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
                    <StackPanel>
                        <!-- Задача 1 -->
                        <Border Background="White" Margin="0,0,0,10">
                            <Grid Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" 
                                         Margin="15,0,15,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Go fishing with Stephen" 
                                              FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="9:00am" Foreground="#666" 
                                              FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Задача 2 -->
                        <Border Background="White" Margin="0,0,0,10">
                            <Grid Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" 
                                         Margin="15,0,15,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Go fishing with Stephen" 
                                              FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="9:00am" Foreground="#666" 
                                              FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Задача 3 -->
                        <Border Background="White" Margin="0,0,0,10">
                            <Grid Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" 
                                         Margin="15,0,15,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Read the book Zlatan" 
                                              FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="9:00am" Foreground="#666" 
                                              FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Задача 4 -->
                        <Border Background="White" Margin="0,0,0,10">
                            <Grid Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" 
                                         Margin="15,0,15,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Meet according with design team..." 
                                              FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="9:00am" Foreground="#666" 
                                              FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Задача 5 -->
                        <Border Background="White" Margin="0,0,0,10">
                            <Grid Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" 
                                         Margin="15,0,15,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Meet according with design team..." 
                                              FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="9:00am" Foreground="#666" 
                                              FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Задача 6 -->
                        <Border Background="White">
                            <Grid Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" 
                                         Margin="15,0,15,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Meet according with design team..." 
                                              FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="9:00am" Foreground="#666" 
                                              FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Кнопка добавления задачи -->
                <Button Grid.Row="2" Content="+" 
                       Background="#de4949" Foreground="White" 
                       FontSize="20" FontWeight="Bold"
                       Height="40" Margin="20,10"
                       BorderThickness="0"/>
            </Grid>

            <!-- Правая часть - детали задачи -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок деталей -->
                    <TextBlock Grid.Row="0" Text="Зарядков" 
                              FontSize="16" FontWeight="Bold"
                              Margin="0,0,0,20"/>

                    <!-- Детали задачи -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="18:00" 
                                  Foreground="#666" FontSize="12" Margin="0,0,0,5"/>
                        <TextBlock Text="от Января 2022" 
                                  Foreground="#666" FontSize="12" Margin="0,0,0,20"/>

                        <TextBlock Text="Lorem ipsum dolor sit amet," 
                                  FontSize="14" Margin="0,0,0,5"/>
                        <TextBlock Text="consectetur adipiscing." 
                                  FontSize="14"/>
                    </StackPanel>

                    <!-- Кнопки действий -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" 
                               HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Готово" Background="#de4949" 
                               Foreground="White" Padding="25,8"
                               FontWeight="SemiBold" Margin="0,0,10,0"
                               BorderThickness="0"/>

                        <Button Content="Удалить" Background="White" 
                               Foreground="#666" Padding="25,8"
                               FontWeight="SemiBold" 
                               BorderBrush="#E0E0E0" BorderThickness="1"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>